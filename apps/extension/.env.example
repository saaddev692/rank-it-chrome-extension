# Build-time settings for the extension (read by `pnpm build`). Nothing here is a secret:
# all three values end up in the built extension, which anyone with it installed can read.

# OAuth client ID of type "Chrome Extension" from Google Cloud Console
# (APIs & Services -> Credentials). Looks like 1234567890-abc...apps.googleusercontent.com
OAUTH_CLIENT_ID=

# Public key that pins the extension ID. Generate with `pnpm gen:key` from the repo root.
EXTENSION_PUBLIC_KEY=

# Where the local parsing proxy (apps/server) listens.
PROXY_URL=http://127.0.0.1:8787
