# --- Required ---------------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey . Never commit the real value.
GEMINI_API_KEY=

# Origin(s) allowed to call this proxy, comma-separated. Use the extension ID printed
# by `pnpm gen:key` (it never changes once the key is pinned in the manifest).
ALLOWED_ORIGINS=chrome-extension://your-extension-id-here

# --- Optional (defaults shown) ----------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# Interactions API revision header sent with each request.
GEMINI_API_REVISION=2026-05-20
GEMINI_TIMEOUT_MS=30000

# Bind to loopback only. Do not expose this proxy to the network.
HOST=127.0.0.1
PORT=8787

# SQLite order history (one row per Gmail account + message). A message already in the
# history is never sent to Gemini again unless the extension asks for a re-parse.
DB_PATH=./data/orders.db
