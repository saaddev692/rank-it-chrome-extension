# SMTP account used by `pnpm send:test-emails` to deliver mock order confirmations.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character value below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=
# Optional: address in the From header. Defaults to SMTP_USER. The display name is set to the
# retailer ("MYTHERESA", "Selfridges", "REVOLVE") automatically.
SMTP_FROM_ADDRESS=
